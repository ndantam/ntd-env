# Defaults
defaults
auth             on
tls              on
# The cert location on Debian. You may need to adjust.
tls_trust_file   /etc/ssl/certs/ca-certificates.crt
logfile          ~/.local/log/msmtp.log

# Mines Account
account          mines
host             smtp.office365.com
port             587
auth             xoauth2
from             ndantam@mines.edu
user             ndantam@mines.edu
passwordeval     python3 /home/ntd/bin/mutt_oauth2.py /home/ntd/doc/private/mbsync-token-mines.gpg

# passwordeval     secret-tool lookup host smtp.office365.com user ndantam@mines.edu token token

# default account
account default : mines
